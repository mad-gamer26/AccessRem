<Application x:Class="AccessRem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Font sizes are replaced at startup to follow Windows "Text size" (Accessibility › Text size). -->
            <sys:Double x:Key="BaseFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
            <sys:Double x:Key="HeadingFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">17</sys:Double>
            <sys:Double x:Key="TitleFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ui/Theme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
