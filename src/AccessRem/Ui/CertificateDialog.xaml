<Window x:Class="AccessRem.Ui.CertificateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security warning"
        Style="{DynamicResource AppWindow}"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Style="{DynamicResource HeadingText}" Text="The server's certificate could not be verified" />
        <TextBox x:Name="DetailsBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                 AutomationProperties.Name="Warning details" Margin="0,0,0,12" />
        <Label Style="{DynamicResource FieldLabel}" Content="Certificate _fingerprint (SHA-256):" Target="{Binding ElementName=FingerprintBox}" />
        <TextBox x:Name="FingerprintBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Connect and _do not ask again for this server" Margin="0,0,8,8" Click="TrustAlways_Click" />
            <Button Content="C_onnect this time" Margin="0,0,8,8" Click="Once_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Margin="0,0,0,8" Style="{DynamicResource PrimaryButton}" />
        </WrapPanel>
    </StackPanel>
</Window>
