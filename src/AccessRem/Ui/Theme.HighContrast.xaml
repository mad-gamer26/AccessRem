<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Used whenever Windows high contrast (contrast themes) is on. Every brush follows the
        user's chosen system colours and controls keep their stock templates, so the
        operating system's contrast theme is honoured exactly.
    -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="FocusRingInnerBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="BannerTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="{x:Static SystemColors.HighlightTextColor}" />

    <CornerRadius x:Key="CardRadius">0</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">0</CornerRadius>

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2" StrokeDashArray="1 1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Window}" x:Key="AppWindow">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
    </Style>

    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HeadingText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource HeadingFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadingText}">
        <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="{x:Type TextBlock}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="{x:Type Label}">
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BaseButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="88" />
    </Style>
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}" />
    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseButton}" />
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}" />
    <Style x:Key="ActionTileButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style x:Key="SecondaryTileButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionTileButton}" />

    <Style x:Key="ListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="Pill" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
</ResourceDictionary>
