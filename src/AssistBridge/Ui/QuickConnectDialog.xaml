<Window x:Class="AssistBridge.Ui.QuickConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AssistBridge.Ui"
        Title="Connect"
        Style="{DynamicResource AppWindow}"
        Width="580" SizeToContent="Height" MaxHeight="920"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ConnectButton" Content="_Connect" IsDefault="True" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="Connect_Click" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <Label Style="{DynamicResource FieldLabel}" Content="Paste an nvdaremote:// _link (optional):" Target="{Binding ElementName=LinkBox}" />
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Content="_Use link" Margin="8,0,0,0" Click="UseLink_Click" />
                    <TextBox x:Name="LinkBox" AutomationProperties.HelpText="A link sent by the other person fills in everything below." />
                </DockPanel>

                <GroupBox Header="What would you like to do?">
                    <StackPanel>
                        <RadioButton x:Name="FollowerRadio" GroupName="Mode" IsChecked="True">
                            <AccessText Text="G_et help: let the other person control this computer" TextWrapping="Wrap" />
                        </RadioButton>
                        <RadioButton x:Name="LeaderRadio" GroupName="Mode">
                            <AccessText Text="Gi_ve help: control the other computer" TextWrapping="Wrap" />
                        </RadioButton>
                    </StackPanel>
                </GroupBox>

                <ui:ConnectionFields x:Name="Fields" />

                <CheckBox x:Name="SaveBox" Margin="0,14,0,4" Checked="SaveBox_Changed" Unchecked="SaveBox_Changed">
                    <AccessText Text="_Save as a computer for next time" />
                </CheckBox>
                <StackPanel x:Name="SaveNamePanel" Visibility="Collapsed">
                    <Label Style="{DynamicResource FieldLabel}" Content="_Name:" Target="{Binding ElementName=NameBox}" />
                    <TextBox x:Name="NameBox" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
