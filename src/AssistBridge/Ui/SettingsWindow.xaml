<Window x:Class="AssistBridge.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Style="{DynamicResource AppWindow}"
        Width="720" Height="640" MinWidth="560" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
        <TabControl x:Name="Tabs">
            <!-- General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="StartWithWindows"><AccessText Text="Start AssistBridge when I _sign in to Windows" /></CheckBox>
                        <CheckBox x:Name="StartMinimized"><AccessText Text="Start _minimized" /></CheckBox>
                        <CheckBox x:Name="MinimizeToTray"><AccessText Text="Minimizing hides AssistBridge in the _notification area" /></CheckBox>
                        <CheckBox x:Name="CloseToTray"><AccessText Text="_Closing the window keeps AssistBridge running in the notification area" /></CheckBox>
                        <CheckBox x:Name="PlaySounds"><AccessText Text="Play _sounds when connecting, disconnecting and sending the clipboard" /></CheckBox>
                        <CheckBox x:Name="ShowNotifications"><AccessText Text="Show notifications when AssistBridge is in the _background" /></CheckBox>
                        <CheckBox x:Name="HandleLinks"><AccessText Text="Open nvdaremote:// _links with AssistBridge" /></CheckBox>
                        <CheckBox x:Name="KeepTranscript"><AccessText Text="Keep a speech _transcript during sessions" /></CheckBox>
                        <CheckBox x:Name="ConfirmDisconnect"><AccessText Text="Ask before _disconnecting when this computer is being controlled" /></CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Getting help -->
            <TabItem Header="Getting help">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="12">
                        <TextBlock Style="{DynamicResource SecondaryText}" Margin="0,0,0,10"
                                   Text="While a helper controls this computer, AssistBridge's copy of NVDA reads the screen to them. These options decide what you hear and allow on this computer." />
                        <CheckBox x:Name="SpeakLocally"><AccessText Text="_Speak on this computer too (hear what your helper hears)" TextWrapping="Wrap" /></CheckBox>
                        <CheckBox x:Name="LocalSounds"><AccessText Text="Play NVDA's _beeps and sounds on this computer" TextWrapping="Wrap" /></CheckBox>
                        <CheckBox x:Name="AllowSas"><AccessText Text="_Allow the helper to send Control+Alt+Delete" TextWrapping="Wrap" /></CheckBox>
                        <Border Style="{DynamicResource Card}" Margin="0,8,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="SasStatus" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="InstallSasButton" Content="_Install helper service…" Margin="0,0,8,0" Click="InstallSas_Click" />
                                    <Button x:Name="RemoveSasButton" Content="_Remove helper service…" Click="RemoveSas_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Label Style="{DynamicResource FieldLabel}" Content="_Estimated speaking rate of the helper's voice:" Target="{Binding ElementName=EstimatedRate}" />
                        <Slider x:Name="EstimatedRate" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="False"
                                AutomationProperties.HelpText="Paces say all on this computer to match how fast the helper's voice speaks. Higher is faster." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Giving help -->
            <TabItem Header="Giving help">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="12">
                        <TextBlock Style="{DynamicResource SecondaryText}" Margin="0,0,0,10"
                                   Text="While you control another computer, its screen reader's speech is spoken here by AssistBridge's copy of NVDA." />
                        <CheckBox x:Name="ReadLocalScreen"><AccessText Text="Also read _this computer's screen with NVDA" TextWrapping="Wrap" /></CheckBox>
                        <CheckBox x:Name="MuteOnLocalControl"><AccessText Text="_Mute the remote computer when the keyboard returns to this computer" TextWrapping="Wrap" /></CheckBox>
                        <CheckBox x:Name="ControlOnConnect"><AccessText Text="Start _controlling as soon as the remote computer connects" TextWrapping="Wrap" /></CheckBox>
                        <Label Style="{DynamicResource FieldLabel}" Content="_Voice:" Target="{Binding ElementName=SynthBox}" Margin="0,10,0,0" />
                        <ComboBox x:Name="SynthBox" DisplayMemberPath="Description" SelectedValuePath="Name" />
                        <CheckBox x:Name="CustomRate" Margin="0,10,0,0"><AccessText Text="Set the speech _rate" /></CheckBox>
                        <Slider x:Name="RateSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" AutomationProperties.Name="Speech rate"
                                IsEnabled="{Binding IsChecked, ElementName=CustomRate}" />
                        <CheckBox x:Name="CustomVolume" Margin="0,10,0,0"><AccessText Text="Set the speech v_olume" /></CheckBox>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" AutomationProperties.Name="Speech volume"
                                IsEnabled="{Binding IsChecked, ElementName=CustomVolume}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="NvdaSpeechButton" Content="NVDA _speech settings…" Margin="0,0,8,8" Click="NvdaSpeech_Click" />
                            <Button x:Name="NvdaBrailleButton" Content="NVDA _braille settings…" Margin="0,0,8,8" Click="NvdaBraille_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="NvdaSettingsHint" Style="{DynamicResource SecondaryText}"
                                   Text="NVDA's own speech and braille settings are available while a session is active. Braille displays are detected automatically." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Keyboard -->
            <TabItem Header="Keyboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="12">
                        <TextBlock Style="{DynamicResource SecondaryText}" Margin="0,0,0,10"
                                   Text="These keys work during a session, even while the keyboard is controlling the remote computer. Use NVDA gesture names separated by commas, for example kb:control+alt+shift+f11 or kb:NVDA+alt+tab. NVDA is the Insert key." />
                        <Label Style="{DynamicResource FieldLabel}" Content="Switch the keyboard between this and the remote computer:" Target="{Binding ElementName=ToggleGestures}" />
                        <TextBox x:Name="ToggleGestures" Margin="0,0,0,10" />
                        <Label Style="{DynamicResource FieldLabel}" Content="Send the clipboard:" Target="{Binding ElementName=ClipboardGestures}" />
                        <TextBox x:Name="ClipboardGestures" Margin="0,0,0,10" />
                        <Label Style="{DynamicResource FieldLabel}" Content="Send Control+Alt+Delete to the remote computer:" Target="{Binding ElementName=SasGestures}" />
                        <TextBox x:Name="SasGestures" Margin="0,0,0,10" />
                        <Label Style="{DynamicResource FieldLabel}" Content="Mute or unmute the remote computer:" Target="{Binding ElementName=MuteGestures}" />
                        <TextBox x:Name="MuteGestures" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Certificates -->
            <TabItem Header="Certificates">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Style="{DynamicResource SecondaryText}" Margin="0,0,0,10"
                               Text="Servers whose self-signed certificates you chose to trust." />
                    <Button DockPanel.Dock="Bottom" Content="_Forget selected" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ForgetCertificate_Click" />
                    <ListBox x:Name="CertificateList" AutomationProperties.Name="Trusted servers" />
                </DockPanel>
            </TabItem>

            <!-- Advanced -->
            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="ReplaceWithoutAsking"><AccessText Text="If NVDA is already running, replace it during sessions without _asking" TextWrapping="Wrap" /></CheckBox>
                        <CheckBox x:Name="RestoreNvda"><AccessText Text="Restart the replaced NVDA when the session _ends" TextWrapping="Wrap" /></CheckBox>
                        <Label Style="{DynamicResource FieldLabel}" Content="NVDA _folder (leave empty to use the bundled copy):" Target="{Binding ElementName=NvdaPath}" Margin="0,10,0,0" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="_Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                            <TextBox x:Name="NvdaPath" />
                        </DockPanel>
                        <TextBlock x:Name="NvdaPathStatus" Style="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
                        <Label Style="{DynamicResource FieldLabel}" Content="Transcript _length (entries):" Target="{Binding ElementName=TranscriptLimit}" Margin="0,10,0,0" />
                        <TextBox x:Name="TranscriptLimit" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
