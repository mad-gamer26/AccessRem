<Window x:Class="AssistBridge.Ui.MachineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AssistBridge.Ui"
        Style="{DynamicResource AppWindow}"
        Width="580" SizeToContent="Height" MaxHeight="900"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Save" IsDefault="True" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <Label Style="{DynamicResource FieldLabel}" Content="_Name:" Target="{Binding ElementName=NameBox}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,12" AutomationProperties.HelpText="A friendly name, such as Mum's laptop or Work help desk. Optional." />

                <ui:ConnectionFields x:Name="Fields" />

                <GroupBox Header="When I press Enter on this computer" Margin="0,12,0,12">
                    <StackPanel>
                        <RadioButton x:Name="FollowerRadio" GroupName="Mode" IsChecked="True">
                            <AccessText Text="G_et help: let the other person control this computer" TextWrapping="Wrap" />
                        </RadioButton>
                        <RadioButton x:Name="LeaderRadio" GroupName="Mode">
                            <AccessText Text="Gi_ve help: control the other computer" TextWrapping="Wrap" />
                        </RadioButton>
                    </StackPanel>
                </GroupBox>

                <CheckBox x:Name="AutoConnectBox">
                    <AccessText Text="Connect a_utomatically when AssistBridge starts" TextWrapping="Wrap" />
                </CheckBox>

                <Label Style="{DynamicResource FieldLabel}" Content="N_otes:" Target="{Binding ElementName=NotesBox}" Margin="0,10,0,0" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
